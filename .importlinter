[importlinter]
root_package = scieqlint

[importlinter:contract:cli-no-analysis]
name = CLI must not import analysis layers directly
type = forbidden
source_modules = scieqlint.cli
forbidden_modules =
    scieqlint.scan
    scieqlint.parse
    scieqlint.check
allow_indirect_imports = true

[importlinter:contract:report-no-analysis]
name = Reporters must not import scanner/parser/checker layers
type = forbidden
source_modules = scieqlint.report
forbidden_modules =
    scieqlint.scan
    scieqlint.parse
    scieqlint.check
